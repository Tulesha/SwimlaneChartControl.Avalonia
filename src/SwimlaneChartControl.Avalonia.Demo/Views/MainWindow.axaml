<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SwimlaneChartControl.Avalonia.Demo.ViewModels"
        xmlns:controls="using:SwimlaneChartControl.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
        x:Class="SwimlaneChartControl.Avalonia.Demo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SwimlaneChartControl.Avalonia.Demo"
        Width="960" Height="640">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Swimlane Chart" FontSize="28" FontWeight="Bold" Foreground="#2563EB" />
            <TextBlock
                Text="Scroll to zoom · Ctrl + scroll to pan vertically · Shift + scroll to pan horizontally · drag to pan · click a bar to select"
                FontSize="12" Foreground="Gray" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Content="Nudge schedule"
                        Command="{Binding NudgeScheduleCommand}"
                        ToolTip.Tip="Shifts each task's Start/End in place to demonstrate live redraw" />
                <CheckBox Content="AutoMinZoom" IsChecked="{Binding #Chart.AutoMinZoom}" />
                <CheckBox Content="AutoMaxZoom" IsChecked="{Binding #Chart.AutoMaxZoom}" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="20" Margin="0,12,0,0">
            <TextBlock FontSize="12"
                       Text="{Binding #Chart.ViewportStartDate, StringFormat='Visible from {0:MMM d, yyyy}'}" />
            <TextBlock FontSize="12" Text="{Binding #Chart.ViewportEndDate, StringFormat='to {0:MMM d, yyyy}'}" />
            <TextBlock FontSize="12" Text="{Binding #Chart.SelectedItem, StringFormat='Selected: {0}'}" />
        </StackPanel>

        <controls:SwimlaneChart x:Name="Chart"
                                ItemsSource="{Binding Tasks}"
                                LanePath="Lane"
                                TaskNamePath="Name"
                                StartPath="Start"
                                EndPath="End"
                                BrushPath="Brush"
                                TextBrushPath="TextBrush"
                                Title="Project Schedule" />
    </DockPanel>

</Window>
