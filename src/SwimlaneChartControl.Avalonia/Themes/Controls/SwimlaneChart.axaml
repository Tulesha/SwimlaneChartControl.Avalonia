<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:SwimlaneChartControl.Avalonia">
    <ControlTheme x:Key="{x:Type controls:SwimlaneChart}" TargetType="controls:SwimlaneChart">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="GridLineBrush" Value="{DynamicResource SystemControlBackgroundBaseMediumBrush}" />
        <Setter Property="LaneSeparatorBrush" Value="Transparent" />
        <Setter Property="LaneBackgroundBrush" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <Setter Property="TaskBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        <Setter Property="TaskForeground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        <Setter Property="TodayLineBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate TargetType="controls:SwimlaneChart">
                <Grid ClipToBounds="True"
                      RowDefinitions="*,Auto"
                      ColumnDefinitions="*,Auto">
                    <ScrollBar Name="PART_VerticalScrollBar"
                               Grid.Row="0" Grid.Column="1"
                               Orientation="Vertical"
                               Width="14" />

                    <ScrollBar Name="PART_HorizontalScrollBar"
                               Grid.Row="1" Grid.Column="0"
                               Orientation="Horizontal"
                               Height="14" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>